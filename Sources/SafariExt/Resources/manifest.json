{
  "manifest_version": 2,
  "name": "M3U8 Grab",
  "version": "1.4.0",
  "description": "抓取当前网页里的 M3U8 播放列表地址，一键送到 M3U8 Grab App 下载。",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "M3U8 Grab",
    "default_popup": "popup.html"
  }
}
